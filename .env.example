# EmailJS — envio do formulário de contato (cliente, sem back-end).
#
# 1. Crie uma conta em https://www.emailjs.com
# 2. Adicione um e-mail service (ex.: Gmail) -> copie o SERVICE ID.
# 3. Crie um template com os campos `from_name`, `from_email` e `message`
#    (é o que o formulário envia) -> copie o TEMPLATE ID.
# 4. Em Account > General, copie a PUBLIC KEY.
# 5. Copie este arquivo para `.env.local` e preencha os valores abaixo.
#    `.env.local` está no .gitignore — nunca comite as chaves.
#
# Sem estas variáveis, o formulário funciona em MODO SIMULADO (toast de
# sucesso + log no console) e o código fica pronto para ligar de verdade.

NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
